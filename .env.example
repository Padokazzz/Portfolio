# API externa (blog e formulário de contato)
API_BASE_URL=
NEXT_PUBLIC_API_URL=

# Monetização — preencher somente com valores reais após configuração.
# Sem essas variáveis, nenhuma tag de terceiros é carregada no navegador.
# AdSense: só depois da aprovação do site na conta (ca-pub-...).
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# ID do bloco de anúncio criado no painel do AdSense para os artigos.
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
# GA4: Measurement ID da propriedade (G-...).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
